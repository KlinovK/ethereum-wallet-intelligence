# Host port exposed by Docker Compose.
APP_PORT=8000

# Development-only PostgreSQL settings for Docker Compose.
POSTGRES_DB=ethereum_wallet_intelligence
POSTGRES_USER=ethereum_wallet_intelligence
POSTGRES_PASSWORD=development-only-password

# Optional. Required only when constructing persistence infrastructure or running migrations.
DATABASE_URL=postgresql+asyncpg://ethereum_wallet_intelligence:development-only-password@localhost:5432/ethereum_wallet_intelligence

# Required only for PostgreSQL integration tests. Must target the disposable test service.
POSTGRES_TEST_USER=ethereum_wallet_intelligence_test
POSTGRES_TEST_PASSWORD=development-only-test-password
TEST_DATABASE_URL=postgresql+asyncpg://ethereum_wallet_intelligence_test:development-only-test-password@localhost:5433/ethereum_wallet_intelligence_test

# Optional. Required only when constructing the Ethereum JSON-RPC adapter.
# ETHEREUM_RPC_URL=https://your-ethereum-provider.example
# ETHEREUM_RPC_TIMEOUT_SECONDS=10
# ETHEREUM_RPC_MAX_ATTEMPTS=3
# ETHEREUM_RPC_RETRY_BASE_DELAY_SECONDS=0.25
# ETHEREUM_RPC_RETRY_MAX_DELAY_SECONDS=2
# ETHEREUM_RPC_RETRY_JITTER_RATIO=0.2
